{
	"name": "@aionbuilders/nabu",
	"version": "0.1.0-beta.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "bunx svelte-kit sync && bunx svelte-package && bunx publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"build:e2e": "VITE_NABU_E2E=1 vite build",
		"test:e2e": "playwright test",
		"test:e2e:dev": "NABU_E2E_DEV=1 playwright test",
		"test": "bun run test:unit && bun run test:e2e"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"svelte": "./dist/ui/index.js"
		},
		"./extend": {
			"types": "./dist/extend.d.ts",
			"svelte": "./dist/extend.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./nabu-theme.css": {
			"default": "./dist/nabu-theme.css"
		},
		"./themes/atelier.css": {
			"default": "./dist/themes/atelier.css"
		}
	},
	"peerDependencies": {
		"svelte": "^5.20.0"
	},
	"devDependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/syne": "^5.3.0",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vitest/coverage-v8": "^5.0.5",
		"fake-indexeddb": "^6.2.6",
		"happy-dom": "^16.0.0",
		"playwright": "^1.58.2",
		"publint": "^0.3.17",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"description": "Modular, local-first block editor engine for Svelte 5, built on a single contenteditable architecture and Loro-CRDT.",
	"author": {
		"name": "Killian Di Vincenzo",
		"url": "https://github.com/killiandvcz"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aionbuilders/nabu.git"
	},
	"homepage": "https://github.com/aionbuilders/nabu#readme",
	"keywords": [
		"svelte",
		"svelte5",
		"editor",
		"block-editor",
		"rich-text",
		"crdt",
		"loro",
		"local-first",
		"collaborative"
	],
	"dependencies": {
		"@aionbuilders/pulse": "^1.0.1",
		"esm-env": "^1.2.2",
		"loro-crdt": "^1.17.1",
		"vite-plugin-wasm": "^3.5.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
